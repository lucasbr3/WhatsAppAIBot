# === WhatsApp ===
WHATSAPP_NUMBER=
SESSION_PATH=./data/session

# === AI (Groq - 100% gratis, sem cartao) ===
# Crie sua chave gratis em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# Alternativa paga (OpenAI). Se GROQ_API_KEY estiver setada, ela tem prioridade.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# === Voice (TTS via Edge-TTS - gratuito, sem chave) ===
TTS_VOICE=pt-BR-FranciscaNeural
CALL_AUTO_ANSWER=true

# === Database ===
DATABASE_URL=./data/bot.db

# === Dashboard ===
PORT=3000
JWT_SECRET=change-this-to-a-random-secret
ADMIN_USER=admin
ADMIN_PASSWORD=change-this
DOMAIN_URL=https://meubot.com

# === Music ===
MUSIC_SOURCE=youtube    # local | youtube
MAX_PLAYLIST_SIZE=50

# === Security ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
AUTH_DISABLED=false   # Set true to disable JWT auth (dashboard opens without login)

# === Meta WhatsApp Business Calling API (gratuito para chamadas RECEBIDAS) ===
# 1. Crie uma conta Meta Business + app + numero WhatsApp Business API em developers.facebook.com
# 2. Gere o token de acesso (token do app ou system user com permissoes whatsapp_business_messaging)
# 3. Phone number ID: esta no app / WhatsApp / API Setup
# 4. WEBHOOK VERIFY: configure a URL https://SEU-DOMINIO/webhook/meta com este verify token
# Chamadas recebidas sao gratuitas; apenas chamadas de SAIDA cobram (~$0.005/min)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=whiskeyverify123
META_GRAPH_VERSION=v21.0
